# Copy to .env.local and uncomment one. Defaults to http://localhost:8000 when unset.
# Include any ingress prefix (e.g. /lume-model-api) in the base URL; the client appends the
# OpenAPI paths (/api/v1/...) to it.

# docker compose `lume-model-api` (demo model), the default:
# VITE_LUME_API_BASE_URL=http://localhost:8000
# docker compose --profile full `lume-model-api-full` (cu_hxr_staged):
# VITE_LUME_API_BASE_URL=http://localhost:8001
# SLAC dev deployment (SLAC network only):
# VITE_LUME_API_BASE_URL=https://ad-accel-online-ml-dev.slac.stanford.edu/lume-model-api

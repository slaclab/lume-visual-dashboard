# Vite settings: copy to .env.local and uncomment one. Defaults to http://localhost:8000 when unset.
# Include any ingress prefix (e.g. /lume-model-api) in the base URL; the client appends the
# OpenAPI paths (/api/v1/...) to it.

# docker compose `lume-model-api` (demo model), the default:
# VITE_LUME_API_BASE_URL=http://localhost:8000
# docker compose --profile full `lume-model-api-full` (cu_hxr_staged):
# VITE_LUME_API_BASE_URL=http://localhost:8001
# SLAC dev deployment (SLAC network only):
# VITE_LUME_API_BASE_URL=https://ad-accel-online-ml-dev.slac.stanford.edu/lume-model-api

# Canopy (Hare live PV data). Defaults to http://localhost:8050 with key `dev`, matching the
# docker compose `canopy` service. The key is bundled into the browser, so use a read-only key.
# VITE_CANOPY_API_BASE_URL=http://localhost:8050
# VITE_CANOPY_API_KEY=dev

# --- docker compose `canopy` service: real IOC instead of simulated data ---
# These are read by docker compose, not Vite, so put them in a repo-root `.env` (not
# `.env.local`), then `docker compose up -d canopy`. Unset = simulation backend.
# Use explicit unicast addresses (space-separated): broadcast discovery doesn't cross Docker's
# bridged network. host.docker.internal reaches an IOC running on this machine.
# CANOPY_EPICS__BACKEND=epics
# EPICS_CA_ADDR_LIST=host.docker.internal
# EPICS_CA_AUTO_ADDR_LIST=NO
# EPICS_PVA_ADDR_LIST=host.docker.internal
# EPICS_PVA_AUTO_ADDR_LIST=NO
# Seconds to wait for a PV before Hare reports it `connected: false` (default 5).
# CANOPY_EPICS__CA_TIMEOUT_S=5
# CANOPY_EPICS__PVA_TIMEOUT_S=5
